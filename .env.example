# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Path to the Victor config file to load (overrides default config/default.yaml)
VICTOR_CONFIG_PATH=config/default.yaml

# Deployment environment: development | production
VICTOR_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
VICTOR_LOG_LEVEL=INFO

# --- Authentication secrets (added in Phase 3) ---
# Victor never reads a plaintext phrase from here. Provisioning writes an
# Argon2id hash to a local secrets store; this variable would only ever
# point to that store's location, e.g.:
# VICTOR_AUTH_STORE_PATH=config/secrets.yaml
